ANTHROPIC_API_KEY=your_key_here

# Shared password for /admin/feedback (HTTP Basic Auth, any username works).
# Leave unset to disable the admin view entirely (it 503s instead of opening).
ADMIN_PASSWORD=choose_a_real_password

# --- Accounts + subscriptions (all optional - signing in / subscribing just
# 500s with a clear message until these are set; anonymous generation is
# unaffected either way) ---

# Signs the session cookie issued after a magic-link click. Any long random
# string - e.g. `openssl rand -base64 32`. Rotating it logs everyone out
# (existing cookies stop verifying) but breaks nothing else.
SESSION_SECRET=generate_a_long_random_string

# Resend (https://resend.com) - free tier covers a small subscriber base.
# Create an API key, and verify a sending domain (or use their shared
# onboarding domain for testing) to get an EMAIL_FROM address.
RESEND_API_KEY=your_resend_key_here
EMAIL_FROM="decide <hello@yourdomain.com>"

# Stripe (https://dashboard.stripe.com) - Developers -> API keys for the
# secret key, Product catalog -> add a recurring Price for STRIPE_PRICE_ID,
# and Developers -> Webhooks -> add an endpoint at
# {your-site}/api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted) for the
# webhook secret.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PRICE_ID=price_your_recurring_price_id
STRIPE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Monthly generation caps per plan (lib/planLimits.ts). NEXT_PUBLIC_-prefixed
# because the pricing page displays these numbers client-side - the same
# vars are read server-side too, so display and enforcement can never
# disagree. Tune against real cost data (see costBudget.ts) once you have
# usage to look at.
NEXT_PUBLIC_FREE_MONTHLY_GENERATIONS=5
NEXT_PUBLIC_PAID_MONTHLY_GENERATIONS=60
