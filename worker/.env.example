ANTHROPIC_API_KEY=your_key_here
REDIS_URL=redis://default:your_password@your-upstash-endpoint.upstash.io:6379

# Optional — real Google Places verification for named meal/activity venues
# (rating, open/closed status, a real Maps link). Generation still works
# fine without it, just skips that check. See worker/src/engine/
# venueVerification.ts.
GOOGLE_PLACES_API_KEY=your_key_here

# DEAD AS OF 17 JULY 2026 — the Amadeus Self-Service API closed on that
# date, so these two variables no longer do anything no matter what you
# put in them. Do not sign up for Amadeus expecting this to work.
#
# Generation is completely unaffected: flights fall back to a real,
# route-and-date-specific Google Flights link with no guessed number,
# which is the intended behaviour rather than a degradation. Read the
# header of worker/src/engine/flightPricing.ts before shopping for a
# replacement — as of August 2026 there is no free real-fare tier left
# for independent developers, and the link is genuinely good enough.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
