ANTHROPIC_API_KEY=your_key_here
REDIS_URL=redis://default:your_password@your-upstash-endpoint.upstash.io:6379

# Optional — real Google Places verification for named meal/activity venues
# (rating, open/closed status, a real Maps link). Generation still works
# fine without it, just skips that check. See worker/src/engine/
# venueVerification.ts.
GOOGLE_PLACES_API_KEY=your_key_here

# Optional — real flight-price lookup for the arrival flight item (replaces
# the model's own guessed fare with a live-checked price). Free self-service
# signup at https://developers.amadeus.com — create an app, use its "API
# Key" and "API Secret". Generation still works fine without these, just
# falls back to a "check the real price" link with no number shown. See
# worker/src/engine/flightPricing.ts.
AMADEUS_API_KEY=your_key_here
AMADEUS_API_SECRET=your_secret_here
